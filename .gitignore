# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv*/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# revu.index's default local graph-blob cache (REVU_INDEX_STORAGE_DIR)
.revu/
# GitHub App private key(s), mounted read-only into api/worker containers
.secrets/
*.private-key.pem

# uv
uv.lock.bak

# Env / secrets
.env
.env.*
!.env.example

# Node / Next.js
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/.env*.local

# Runtime data (root-level only — a bare "runs/" also matched
# apps/web/src/app/(protected)/runs/, silently hiding that route from git)
/runs/
*.sqlite3
*.db

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
