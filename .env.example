# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=revu
POSTGRES_PASSWORD=revu_dev_password
POSTGRES_DB=revu
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port mappings (container-internal ports above are unaffected).
# Defaults avoid colliding with other local projects' Postgres/Redis on 5432/6379.
HOST_POSTGRES_PORT=5434
HOST_REDIS_PORT=6380
# Tenant isolation is enforced by Postgres row-level security, which only
# applies to roles that are neither superuser nor BYPASSRLS. The API, worker
# and webhook relay therefore connect as `revu_app` (created by the
# migrations); only Alembic connects as the schema owner above.
# Async URL used by the API/worker when run outside Docker (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://revu_app:revu_app_dev_password@postgres:5432/revu
# docker-compose reads this one for the containers, so an older .env whose
# DATABASE_URL still names the owner can't silently switch isolation off.
APP_DATABASE_URL=postgresql+asyncpg://revu_app:revu_app_dev_password@postgres:5432/revu
# Password the first migration gives `revu_app` (ignored once it exists).
REVU_APP_DB_PASSWORD=revu_app_dev_password
# Sync URL used by Alembic migrations (psycopg driver): the schema owner.
DATABASE_URL_SYNC=postgresql+psycopg://revu:revu_dev_password@postgres:5432/revu

# --- Redis (ARQ queue + result cache) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-dev-only-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Credential encryption ---
# Encrypts the stored GitHub App credentials and every organisation's AI
# provider keys. Never change it once keys are stored: they become
# undecryptable (re-enter them on the AI Providers screen if you must).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-dev-only-not-for-production

# --- LLM providers ---
# There are deliberately NO provider API keys or model names here. Each
# organisation adds its providers (Anthropic, OpenAI, Groq, or any
# OpenAI-compatible endpoint such as a local Ollama) and picks a model per
# review step on the AI Providers screen; keys are stored encrypted in the
# database. Keys left in this file are ignored.
#
# May provider endpoints be on private/loopback networks (an Ollama on this
# machine, a vLLM server on the company network)? Unset = yes outside
# production, no in production. On-prem deployments serving their own
# model set it to true.
REVU_ALLOW_PRIVATE_PROVIDER_URLS=

# --- GitHub App (Stage 10) ---
# Optional: with these blank the app runs and the manual "paste a diff"
# flow works; the GitHub screens report the App as not configured.
# See README "Connecting GitHub" for how to register the App.
GITHUB_APP_ID=
# The App's URL slug (github.com/apps/<slug>), used for the install link.
GITHUB_APP_SLUG=
# Private key: a file path (preferred; in Docker put the .pem in ./.secrets
# and use /run/revu-secrets/<file>.pem), or inline PEM with literal 
 escapes.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# OAuth credentials of the same App: used to verify the user who installs it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Simpler: leave all GITHUB_* above blank and click "Create GitHub App" in the
# app (GitHub page); credentials are then stored encrypted with
# CREDENTIAL_ENCRYPTION_KEY. Where the browser reaches the web app:
WEB_APP_URL=http://localhost:3000
# Public URL for POST /github/webhook, if any; blank = relay via smee.io.
GITHUB_WEBHOOK_PUBLIC_URL=
# Local git cache for connected repos (worker). Docker overrides to /data/repos.
# Each repository gets its own <org_id>/<repo_id>/ directory under it.
REVU_REPO_CACHE_DIR=.revu/repos
# Signed branch-index blobs, also per <org_id>/<repo_id>/. Docker: /data/index.
# Blobs are HMAC-signed with a key derived from CREDENTIAL_ENCRYPTION_KEY, so
# changing that key makes existing indexes rebuild from scratch.
REVU_INDEX_STORAGE_DIR=.revu/index-graphs

# --- Data lifecycle + operators ---
# Days a disconnected repository's data (reviews, indexes, clone) is kept
# before the worker's hourly retention job deletes it. API and worker both
# read it. "Delete data now" on a disconnected connection skips the wait.
REVU_DISCONNECTED_RETENTION_DAYS=30
# Comma-separated emails made platform admin at signup/login: the only users
# who may create the GitHub App every organisation installs. One-way; revoke
# with `docker compose exec api python -m api.cli platform-admin revoke EMAIL`.
REVU_PLATFORM_ADMIN_EMAILS=

# --- App/runtime ---
ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
