# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=revu
POSTGRES_PASSWORD=revu_dev_password
POSTGRES_DB=revu
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port mappings (container-internal ports above are unaffected).
# Defaults avoid colliding with other local projects' Postgres/Redis on 5432/6379.
HOST_POSTGRES_PORT=5434
HOST_REDIS_PORT=6380
# Async URL used by the API/worker (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://revu:revu_dev_password@postgres:5432/revu
# Sync URL used by Alembic migrations (psycopg driver)
DATABASE_URL_SYNC=postgresql+psycopg://revu:revu_dev_password@postgres:5432/revu

# --- Redis (ARQ queue + result cache) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-dev-only-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Provider credential envelope encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-dev-only-not-for-production

# --- LLM providers (used by the engine via LiteLLM) ---
# At least one is required for the reviewer to run. Leave unused ones blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default model routes (overridable per-org later via the AI Providers screen)
REVU_MODEL_SCREEN=claude-haiku-4-5-20251001
REVU_MODEL_REVIEW=claude-sonnet-5
REVU_MODEL_VERIFY=claude-sonnet-5

# --- GitHub App (Stage 10) ---
# Optional: with these blank the app runs and the manual "paste a diff"
# flow works; the GitHub screens report the App as not configured.
# See README "Connecting GitHub" for how to register the App.
GITHUB_APP_ID=
# The App's URL slug (github.com/apps/<slug>), used for the install link.
GITHUB_APP_SLUG=
# Private key: a file path (preferred; in Docker put the .pem in ./.secrets
# and use /run/revu-secrets/<file>.pem), or inline PEM with literal 
 escapes.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# OAuth credentials of the same App: used to verify the user who installs it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Simpler: leave all GITHUB_* above blank and click "Create GitHub App" in the
# app (GitHub page); credentials are then stored encrypted with
# CREDENTIAL_ENCRYPTION_KEY. Where the browser reaches the web app:
WEB_APP_URL=http://localhost:3000
# Public URL for POST /github/webhook, if any; blank = relay via smee.io.
GITHUB_WEBHOOK_PUBLIC_URL=
# Local git cache for connected repos (worker). Docker overrides to /data/repos.
# Each repository gets its own <org_id>/<repo_id>/ directory under it.
REVU_REPO_CACHE_DIR=.revu/repos
# Signed branch-index blobs, also per <org_id>/<repo_id>/. Docker: /data/index.
# Blobs are HMAC-signed with a key derived from CREDENTIAL_ENCRYPTION_KEY, so
# changing that key makes existing indexes rebuild from scratch.
REVU_INDEX_STORAGE_DIR=.revu/index-graphs

# --- App/runtime ---
ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
