# shadcn's CLI (a devDependency, not shipped to the browser) pulls in a Babel
# toolchain whose peer requirements conflict with @vitejs/plugin-react's own
# peer on @rolldown/plugin-babel (both installed for Vitest). Neither
# conflict is real at runtime, so npm's default strict peer resolution is
# disabled here rather than in ad-hoc install flags that Docker's `npm ci`
# wouldn't otherwise pick up.
legacy-peer-deps=true
